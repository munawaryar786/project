// prisma/schema.prisma
// Provider: MongoDB (production). Use `prisma db push` to sync schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// BOOKINGS
// ============================================
model Booking {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  bookingRef String @unique
  status     String @default("PENDING")

  serviceType String

  pickupAddress  String
  dropoffAddress String

  pickupLat  Float?
  pickupLng  Float?
  dropoffLat Float?
  dropoffLng Float?

  scheduledDate  String
  scheduledTime  String
  passengerCount Int    @default(1)
  luggageType    String @default("NONE")
  smallBags       Int    @default(0)
  largeBags       Int    @default(0)

  wheelchairNeeded Boolean @default(false)
  seniorPassenger  Boolean @default(false)
  ztpCardHolder    Boolean @default(false)
  wheelchairUser   Boolean @default(false)
  companionRequired Boolean @default(false)
  medicalAppointment Boolean @default(false)
  waitingTimeRequired Boolean @default(false)
  assistanceLevel String?
  wheelchairType String?
  canTransferToSeat Boolean?
  wavRequired Boolean @default(false)
  passengerRemainsInWheelchair Boolean @default(false)
  companionCount Int @default(0)
  hospitalName String?
  department String?
  appointmentDate String?
  appointmentTime String?
  tripType String?
  returnDate String?
  returnTime String?
  waitingDuration String?
  customWaitingDuration String?
  scheduledRide Boolean @default(false)
  recurrence String?
  recurrenceCustom String?
  childFullName String?
  childName String?
  childAge Int?
  childSpecialRequirements String?
  parentFullName String?
  guardianName String?
  parentPrimaryPhone String?
  guardianPhone String?
  parentEmergencyPhone String?
  guardianEmergencyPhone String?
  parentEmail String?
  guardianEmail String?
  educationalInstitutionName String?
  institutionName String?
  institutionAddress String?
  educationalDestinationValidated Boolean @default(false)
  pickupDate String?
  pickupTime String?
  recurrenceType String?

  flightNumber String?
  airline      String?
  waitAndGreet Boolean @default(false)

  customerName      String
  customerEmail     String?
  customerPhone     String
  customerPhoneCode String  @default("+421")
  languagePref      String  @default("slovak")
  specialNotes      String?
  phoneVerified     Boolean @default(false)

  paymentMethod String
  cashAgreed    Boolean @default(false)

  sourceDomain String?

  estimatedPrice  Float?
  distanceKm      Float?
  vehicleRequired String? @default("STANDARD")

  passengerId String? @db.ObjectId
  passenger   Passenger? @relation(fields: [passengerId], references: [id])

  driverId String? @db.ObjectId
  driver   Driver? @relation(fields: [driverId], references: [id])

  dispatchStatus String?   @default("NOT_STARTED")
  acceptedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps    OTP[]
  earning DriverEarning?

  @@index([status])
  @@index([passengerId])
  @@index([driverId])
  @@index([dispatchStatus])
  @@index([createdAt])
}

// ============================================
// PASSENGERS
// ============================================
model Passenger {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  phone            String @unique
  phoneVerified    Boolean @default(false)
  fullName         String?
  email            String?
  passwordHash     String?
  profileCompleted Boolean @default(false)

  bookings Booking[]
  otps     PassengerOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phoneVerified])
}

model PassengerOtp {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  code        String
  phone       String
  expiresAt   DateTime
  used        Boolean @default(false)

  passengerId String @db.ObjectId
  passenger   Passenger @relation(fields: [passengerId], references: [id])

  createdAt DateTime @default(now())

  @@index([passengerId, code])
  @@index([phone, code])
  @@index([expiresAt])
  @@map("passenger_otps")
}

// ============================================
// OTP VERIFICATION
// ============================================
model OTP {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String
  phone     String
  expiresAt DateTime
  used      Boolean  @default(false)

  bookingId String  @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())

  @@index([bookingId, code])
  @@index([expiresAt])
}

// ============================================
// DRIVERS
// ============================================
model Driver {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  fullName      String
  phone         String  @unique
  email         String? @unique
  licenseNumber String?
  status        String  @default("ACTIVE")

  vehicleId String?  @db.ObjectId
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleType  String?
  vehiclePlate String?
  vehicleCapacity Int @default(4)

  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?
  isOnTrip           Boolean   @default(false)
  isOnline           Boolean   @default(false)

  passwordHash String?

  bookings        Booking[]
  locationHistory DriverLocation[]
  earnings        DriverEarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isOnline])
  @@index([isOnTrip])
  @@index([vehicleId])
}

// ============================================
// DRIVER EARNINGS
// ============================================
model DriverEarning {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bookingId String @unique @db.ObjectId
  driverId  String @db.ObjectId

  booking Booking @relation(fields: [bookingId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  bookingRef String

  totalFare      Float
  driverAmount   Float
  platformAmount Float
  commissionRate Float @default(20)

  paymentMethod String

  cashCollected Boolean @default(false)

  payoutStatus  String @default("PENDING")
  paymentStatus String @default("UNPAID")

  notes String?

  completedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([driverId])
  @@index([payoutStatus])
  @@index([paymentStatus])
  @@index([completedAt])
  @@map("driver_earnings")
}

// ============================================
// DRIVER LOCATION HISTORY
// ============================================
model DriverLocation {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  driverId String @db.ObjectId
  driver   Driver @relation(fields: [driverId], references: [id])

  lat     Float
  lng     Float
  speed   Float?
  heading Float?

  timestamp DateTime @default(now())

  @@index([driverId, timestamp])
  @@map("driver_locations")
}

// ============================================
// RIDE REQUESTS
// ============================================
model RideRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bookingId String @db.ObjectId
  driverId  String @db.ObjectId

  status String @default("PENDING")

  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([driverId])
  @@index([status])
  @@index([expiresAt])
  @@map("ride_requests")
}

// ============================================
// ADMIN USERS
// ============================================
model AdminUser {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  email        String @unique
  passwordHash String
  fullName     String
  role         String @default("DISPATCHER")

  createdAt DateTime @default(now())
}

// ============================================
// VEHICLES
// ============================================
model Vehicle {
  id                   String  @id @default(auto()) @map("_id") @db.ObjectId
  plateNumber          String  @unique
  type                 String
  brand                String?
  model                String?
  year                 Int?
  maxPassengers        Int     @default(4)
  wheelchairAccessible Boolean @default(false)

  isRental     Boolean @default(false)
  rentalStatus String  @default("AVAILABLE")
  weeklyRate   Float?

  currentMileageKm Int?
  serviceNotes     String?
  nextServiceDate  DateTime?
  stkValidUntil    DateTime?
  weeklyRentalPrice Float?
  dailyRentalPrice  Float?
  baseRidePrice     Float?

  status  String   @default("ACTIVE")
  drivers Driver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PRICING SETTINGS
// ============================================
model PricingSettings {
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  key                   String @unique @default("default")
  standardTaxiBasePrice Float  @default(3)
  pricePerKm            Float  @default(1.5)
  airportTransferPrice  Float  @default(5)
  tourismTransferPrice  Float  @default(0)
  weeklyVehicleRentalPrice Float @default(120)
  dailyVehicleRentalPrice  Float @default(25)
  minimumFare           Float  @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// CONTACT MESSAGES
// ============================================
model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ============================================
// RENTAL INQUIRIES
// ============================================
model RentalInquiry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String
  email       String?
  licenseNumber String?
  workPlatform String?
  vehicleType String
  vehicleSelected String?
  rentalStartDate String?
  rentalDuration String?
  weeklyRentalPlan String?
  notes       String?
  message     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}
