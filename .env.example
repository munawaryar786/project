ADMIN_BOOKING_EMAIL=bookings@example.com
BOOKING_NOTIFICATION_EMAIL=
ADMIN_EMAIL=

# Required server-side security configuration. Generate unique 32+ character secrets.
DATABASE_URL=
AUTH_SIGNING_SECRET=
CSRF_HMAC_SECRET=
APP_ORIGIN=https://drivo.sk

NEXT_PUBLIC_SITE_URL=https://drivo.sk
PUBLIC_SITE_URL=
APP_URL=
NEXT_PUBLIC_BASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
EMAIL_FROM=
RESEND_API_KEY=

# Public availability flag. Keep false to hide and block new Children Transport bookings.
NEXT_PUBLIC_CHILDREN_TRANSPORT_ENABLED=false

DRIVO_ALLOW_LOCALHOST_ORIGIN=false

# Phase 3D private Redis (use rediss:// in production)
REDIS_URL=redis://127.0.0.1:6379
DRIVO_REALTIME_PORT=3101
DRIVO_REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# Phase 3E navigation (server key stays private; browser key is domain restricted)
GOOGLE_ROUTES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NAVIGATION_ROUTE_MAX_AGE_SECONDS=120
NAVIGATION_ROUTE_REFRESH_DISTANCE_METERS=250
NAVIGATION_REROUTE_DEVIATION_METERS=150
NAVIGATION_LOCATION_INTERVAL_MS=10000
NAVIGATION_LOCATION_MAX_AGE_SECONDS=45

DRIVO_SCHEDULED_MARKET_TIMEZONE=Europe/Bratislava
DRIVO_SCHEDULED_RIDE_BUFFER_MINUTES=15
DRIVO_SCHEDULED_MIN_CLAIM_LEAD_MINUTES=15

# Twilio Verify (server-only; never prefix with NEXT_PUBLIC_)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
