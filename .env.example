ADMIN_BOOKING_EMAIL=
BOOKING_NOTIFICATION_EMAIL=
ADMIN_EMAIL=

# Required server-side security configuration. Generate unique 32+ character secrets.
DATABASE_URL=
AUTH_SIGNING_SECRET=
CSRF_HMAC_SECRET=
APP_ORIGIN=

NEXT_PUBLIC_SITE_URL=
PUBLIC_SITE_URL=
APP_URL=
NEXT_PUBLIC_BASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
EMAIL_FROM=
RESEND_API_KEY=

# Public availability flag. Keep false to hide and block new Children Transport bookings.
NEXT_PUBLIC_CHILDREN_TRANSPORT_ENABLED=

DRIVO_ALLOW_LOCALHOST_ORIGIN=

# Server-only Twilio Verify settings. Leave empty until a provider is configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional registration OTP mode: verify (default) or messaging.
DRIVO_REGISTRATION_OTP_PROVIDER=
DRIVO_OTP_HMAC_SECRET=

# Server-side Redis used by rate limiting and realtime workers.
REDIS_URL=
AUTH_RATE_LIMIT_KEY_SECRET=
